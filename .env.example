DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fakeflix"

# MinIO (S3-compatible storage). Also used by docker-compose as the MinIO root user/password.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=fakeflix
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
